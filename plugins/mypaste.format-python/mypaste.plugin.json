{
  "manifestVersion": 1,
  "id": "mypaste.format-python",
  "name": "Python Format",
  "version": "1.1.0",
  "description": "使用本机可用工具格式化 Python；依赖缺失或语法错误时保留原文。",
  "capabilities": ["selection.read", "clipboard.write"],
  "runtime": {"protocolVersion": 1, "entrypoint": "run"},
  "commands": [{
    "id": "format",
    "title": "格式化 Python",
    "description": "本机格式化当前文本；失败时不写入剪贴板。",
    "input": ["text/plain"],
    "output": ["text/plain"],
    "capabilities": ["selection.read", "clipboard.write"],
    "appliesTo": ["text", "rich_text"],
    "languages": ["python"]
  }]
}
