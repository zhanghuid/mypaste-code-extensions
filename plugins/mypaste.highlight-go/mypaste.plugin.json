{
  "manifestVersion": 1,
  "id": "mypaste.highlight-go",
  "name": "Go Syntax Highlight",
  "version": "1.1.0",
  "description": "为 MyPaste 提供 Go 的有界语法高亮 token，不写入剪贴板。",
  "capabilities": ["selection.render"],
  "runtime": {
    "protocolVersion": 1,
    "entrypoint": "run"
  },
  "commands": [
    {
      "id": "highlight",
      "title": "高亮 Go",
      "description": "只读返回 Go 语法 token；失败时 MyPaste 自动回退内置高亮。",
      "input": ["text/plain"],
      "output": ["application/vnd.mypaste.render+json"],
      "capabilities": ["selection.render"],
      "appliesTo": ["text", "rich_text"],
      "languages": ["go"]
    }
  ]
}
