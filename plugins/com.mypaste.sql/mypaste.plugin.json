{
  "manifestVersion": 3,
  "kind": "ui",
  "id": "com.mypaste.sql",
  "name": "SQL Toolkit",
  "version": "4.1.0",
  "description": "七种方言的 SQL 工作区：语法高亮、括号与子句顺序诊断、美化与压缩都在页面内完成，不执行 SQL、不联网；方言、关键字大小写与缩进随页面切换，长行默认自动换行，复制由宿主写入剪贴板。",
  "capabilities": [
    "entity.read",
    "clipboard.write"
  ],
  "surface": {
    "entry": "preview.html",
    "forms": [
      "text"
    ],
    "role": "open",
    "chrome": "page"
  }
}
