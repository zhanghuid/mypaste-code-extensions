{
  "manifestVersion": 3,
  "id": "com.mypaste.diff-view",
  "name": "高亮对比",
  "version": "3.2.2",
  "kind": "ui",
  "description": "把这条文本与屏幕上相邻的一条文本逐行对照：先对齐整行，再只标出真正改动的词。对比在本机完成，不联网；除本次条目外只读相邻的一条文本。",
  "capabilities": [
    "entity.read",
    "entity.save",
    "clipboard.write",
    "companion.read"
  ],
  "surface": {
    "entry": "preview.html",
    "forms": [
      "text"
    ],
    "role": "open",
    "chrome": "page"
  },
  "commands": [
    {
      "id": "clipboard.diff-view",
      "title": "高亮对比",
      "description": "与相邻的一条文本逐行对比，只高亮真正改动的词",
      "forms": [
        "text",
        "link",
        "color",
        "file"
      ],
      "placement": [
        "card-action"
      ]
    }
  ]
}
