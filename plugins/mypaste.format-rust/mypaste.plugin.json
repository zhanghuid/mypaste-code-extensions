{
  "manifestVersion": 2,
  "id": "mypaste.format-rust",
  "name": "Rust Format",
  "version": "2.1.0",
  "description": "使用本机可用工具格式化 Rust；依赖缺失或语法错误时保留原文。",
  "capabilities": [
    "selection.read"
  ],
  "runtime": {
    "protocolVersion": 2,
    "entrypoint": "run"
  },
  "commands": [
    {
      "id": "format",
      "title": "格式化 Rust",
      "description": "本机格式化当前文本；失败时不写入剪贴板。",
      "input": [
        "text/plain"
      ],
      "output": [
        "text/plain"
      ],
      "capabilities": [
        "selection.read"
      ],
      "languages": [
        "rust"
      ],
      "forms": [
        "plain",
        "rich"
      ],
      "surface": "editor"
    }
  ]
}
