{
  "manifestVersion": 3,
  "id": "com.mypaste.image-edit",
  "name": "图片编辑",
  "version": "3.0.0",
  "kind": "ui",
  "description": "在本地裁剪、旋转、翻转、标注与马赛克，另存为新的图片条目或复制到剪贴板；原图保持不变。编辑只作用于宿主交给本次命令的那一张图片。",
  "capabilities": [
    "entity.read",
    "entity.save",
    "clipboard.write"
  ],
  "surface": {
    "entry": "preview.html",
    "forms": [
      "image"
    ],
    "role": "open"
  },
  "commands": [
    {
      "id": "clipboard.image-edit",
      "title": "编辑图片",
      "description": "裁剪、标注、马赛克，另存为新条目",
      "forms": [
        "image"
      ],
      "placement": [
        "card-action"
      ]
    }
  ]
}
