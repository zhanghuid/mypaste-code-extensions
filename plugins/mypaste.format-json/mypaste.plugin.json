{
  "manifestVersion": 1,
  "id": "mypaste.format-json",
  "name": "JSON Format",
  "version": "1.2.0",
  "description": "使用本机 Python 标准库保守格式化 JSON；缩进可在扩展设置里调整，失败时保留原文。",
  "capabilities": ["selection.read", "clipboard.write"],
  "runtime": {"protocolVersion": 1, "entrypoint": "run"},
  "settings": [{
    "key": "indent",
    "type": "integer",
    "title": "缩进空格",
    "description": "格式化结果的每级缩进宽度。",
    "min": 1,
    "max": 8,
    "default": 2
  }],
  "commands": [{
    "id": "format",
    "title": "格式化 JSON",
    "description": "有效 JSON 按设置的缩进宽度排版；无效输入不写入剪贴板。",
    "input": ["text/plain"],
    "output": ["text/plain"],
    "capabilities": ["selection.read", "clipboard.write"],
    "appliesTo": ["text", "rich_text"],
    "languages": ["json"]
  }]
}
