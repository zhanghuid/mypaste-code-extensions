{
  "manifestVersion": 1,
  "id": "mypaste.format-json",
  "name": "JSON Format",
  "version": "1.1.0",
  "description": "使用本机 Python 标准库保守格式化 JSON；失败时保留原文。",
  "capabilities": ["selection.read", "clipboard.write"],
  "runtime": {"protocolVersion": 1, "entrypoint": "run"},
  "commands": [{
    "id": "format",
    "title": "格式化 JSON",
    "description": "有效 JSON 使用两空格缩进；无效输入不写入剪贴板。",
    "input": ["text/plain"],
    "output": ["text/plain"],
    "capabilities": ["selection.read", "clipboard.write"],
    "appliesTo": ["text", "rich_text"],
    "languages": ["json"]
  }]
}
